<Window x:Class="Foldcraft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Foldcraft.App.Views"
        Title="Foldcraft"
        Icon="pack://application:,,,/Foldcraft;component/Assets/Foldcraft.ico"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding Customize.AddFoldersCommand}" />
    </Window.InputBindings>

    <views:NavigationRail Style="{StaticResource NavigationRailStyle}" SelectedIndex="{Binding SelectedTab}"
                          AutomationProperties.Name="Foldcraft screens">
        <views:NavigationRail.Status>
            <StackPanel>
                <!-- A new version: quiet, out of the way and only ever an offer. -->
                <Border DataContext="{Binding Updates}" Padding="24,8" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" views:LiveRegion.Announce="True" AutomationProperties.LiveSetting="Polite"
                                       Text="{Binding BannerText, NotifyOnTargetUpdated=True}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" views:LiveRegion.Announce="True" AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Text="{Binding Note, NotifyOnTargetUpdated=True}"
                                       Visibility="{Binding Note, Converter={StaticResource TextToVisible}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Hyperlink Command="{Binding ReleaseNotesCommand}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Release notes</Hyperlink>
                        </TextBlock>

                        <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisible}}" />

                        <ProgressBar Grid.Column="3" Width="160" Margin="12,0,0,0" VerticalAlignment="Center" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisible}}"
                                     AutomationProperties.Name="Download progress" />

                        <Button Grid.Column="4" Content="Update" Margin="12,0,0,0"
                                Command="{Binding UpdateCommand}"
                                Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVisible}}" />

                        <Button Grid.Column="4" Content="Restart Now" Margin="12,0,0,0"
                                Command="{Binding RestartCommand}"
                                Visibility="{Binding ShowRestart, Converter={StaticResource BoolToVisible}}" />

                        <Button Grid.Column="5" Content="Cancel" Margin="12,0,0,0"
                                AutomationProperties.Name="Cancel download"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisible}}" />

                        <Button Grid.Column="6" Content="Later" Margin="8,0,0,0"
                                Command="{Binding LaterCommand}"
                                Visibility="{Binding ShowLater, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                </Border>

                <Border Padding="24,6" MinHeight="33" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Activity.Message, NotifyOnTargetUpdated=True}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"
                                   views:LiveRegion.Announce="True"
                                   AutomationProperties.LiveSetting="Polite" />

                        <TextBlock Grid.Column="1" Text="{Binding Activity.ProgressText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />

                        <ProgressBar Grid.Column="2" Width="160" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Maximum="{Binding Activity.Total, Mode=OneWay}" Value="{Binding Activity.Completed, Mode=OneWay}"
                                     IsIndeterminate="{Binding Activity.IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding Activity.IsBusy, Converter={StaticResource BoolToVisible}}"
                                     AutomationProperties.Name="Progress" />

                        <Button Grid.Column="3" Content="Cancel" Margin="12,0,0,0"
                                Command="{Binding Activity.CancelCommand}"
                                Visibility="{Binding Activity.CanCancel, Converter={StaticResource BoolToVisible}}" />
                    </Grid>
                </Border>
            </StackPanel>
        </views:NavigationRail.Status>

        <TabItem Header="Customize" views:NavigationRail.Glyph="&#xE771;">
            <views:CustomizeView DataContext="{Binding Customize}" />
        </TabItem>
        <TabItem Header="History" views:NavigationRail.Glyph="&#xE81C;">
            <views:HistoryView DataContext="{Binding History}" />
        </TabItem>
        <TabItem Header="Apps and Games" views:NavigationRail.Glyph="&#xE7FC;">
            <views:AppsView DataContext="{Binding Apps}" />
        </TabItem>
        <TabItem Header="Themes" views:NavigationRail.Glyph="&#xE790;">
            <views:ThemesView DataContext="{Binding Themes}" />
        </TabItem>
        <TabItem Header="Rules" views:NavigationRail.Glyph="&#xE9D5;">
            <views:RulesView DataContext="{Binding Rules}" />
        </TabItem>
        <TabItem Header="Settings" views:NavigationRail.Glyph="&#xE713;" DockPanel.Dock="Bottom">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
        <TabItem Header="About" views:NavigationRail.Glyph="&#xE946;" DockPanel.Dock="Bottom">
            <views:AboutView DataContext="{Binding About}" />
        </TabItem>
    </views:NavigationRail>
</Window>
