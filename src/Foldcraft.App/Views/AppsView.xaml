<UserControl x:Class="Foldcraft.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foldcraft.App.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/Foldcraft;component/Themes/PrimaryButton.xaml" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The heading and the search -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" MinWidth="80"
                    ToolTip="Find the apps and games on this PC. This only reads, and it changes nothing." />
            <TextBlock Text="Apps and Games" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding IncludedLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,12,0" />
                <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"
                        ToolTip="Check everything showing right now" />
                <Button Content="Select None" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="130"
                      Margin="8,0,0,0" AutomationProperties.Name="Filter by where it was found" />
            <TextBlock DockPanel.Dock="Left" Text="Search" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                     AutomationProperties.Name="Search apps and games" />
        </DockPanel>

        <!-- The grid, and what the selected item can change -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ColumnGap}" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}"
                             ItemContainerStyle="{StaticResource TileItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Apps and games found">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <StackPanel>
                                        <Image Width="72" Height="72" HorizontalAlignment="Center"
                                               Source="{Binding Preview, Converter={StaticResource PngToImage}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding SourceName}" Style="{StaticResource CaptionSingleLine}" TextAlignment="Center" />
                                        <DockPanel HorizontalAlignment="Center" ToolTip="{Binding Status}"
                                                   Visibility="{Binding Status, Converter={StaticResource TextToVisible}}">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusSymbol}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding IsReady}" MinWidth="0"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              AutomationProperties.Name="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <views:EmptyState Glyph="&#xE7FC;" Title="{Binding EmptyMessage}"
                                      Visibility="{Binding HasNoTiles, Converter={StaticResource BoolToVisible}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ScrollingCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
                    <StackPanel>
                        <!-- The last run -->
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding Results.Count, Converter={StaticResource CountToVisible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissResultsCommand}" />
                                <TextBlock Text="Results" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Results}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusSymbol}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource StatusText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- With nothing selected -->
                        <TextBlock Text="Select an item to adjust its folder." Style="{StaticResource Caption}"
                                   Visibility="{Binding SelectedTile, Converter={StaticResource NullToVisible}}" />

                        <!-- The selected item -->
                        <StackPanel DataContext="{Binding SelectedTile}"
                                    Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeading}" TextTrimming="CharacterEllipsis" />

                            <Border Style="{StaticResource Stage}" Padding="8" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="72" Height="72" Source="{Binding Preview, Converter={StaticResource PngToImage}}"
                                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Large preview" />
                                    <views:PixelExactImage Source="{Binding MediumPreview, Converter={StaticResource PngToImage}}" Margin="16,0,0,0"
                                                           VerticalAlignment="Center" AutomationProperties.Name="32 pixel preview" />
                                    <views:PixelExactImage Source="{Binding SmallPreview, Converter={StaticResource PngToImage}}" Margin="16,0,0,0"
                                                           VerticalAlignment="Center" AutomationProperties.Name="16 pixel preview" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding QualityNote}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding QualityNote, Converter={StaticResource TextToVisible}}" />
                            <TextBlock Text="{Binding ContrastNote}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Visibility="{Binding ContrastNote, Converter={StaticResource TextToVisible}}" />

                            <TextBlock Text="Folder name" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Folder name" />

                            <TextBlock Text="Folder style" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding DataContext.Shapes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding SelectedShape}" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Folder style" />

                            <TextBlock Text="Colors" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding StartColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"
                                         AutomationProperties.Name="Folder color" ToolTip="Like #2F6FED. Leave empty for the color read from the icon." />
                                <TextBox Grid.Column="2" Text="{Binding EndColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"
                                         AutomationProperties.Name="Second color" ToolTip="Like #16A34A. Leave empty for one solid color." />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Leave empty to use the colors read from the icon." />
                            <TextBlock Text="{Binding ColorMessage}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding ColorMessage, Converter={StaticResource TextToVisible}}" />

                            <StackPanel Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="Logo position" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding DataContext.Anchors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedAnchor}" DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Logo position" />

                                <TextBlock Text="Logo size" Style="{StaticResource Label}" />
                                <Slider Minimum="{Binding MinScale}" Maximum="{Binding MaxScale}" Value="{Binding Scale}"
                                        SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Logo size" />

                                <TextBlock Text="Plate behind the logo" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding DataContext.Plates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedPlate}" DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Plate behind the logo" />
                            </StackPanel>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0"
                                        ToolTip="Go back to the colors and layout Foldcraft chose" />
                                <Button Content="Use on a Folder..."
                                        Command="{Binding DataContext.ThemeExistingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Give a folder you already have this look, such as a game library on another drive. You can undo this from History." />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Where the folders go, the install folder choice and the button -->
        <Border Grid.Row="3" Style="{StaticResource NoteCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Choose Location..." Command="{Binding PickDestinationCommand}" Margin="8,0,0,0" />
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ClashChoices}" SelectedItem="{Binding SelectedClash}"
                              DisplayMemberPath="Name" Margin="8,0,0,0" MinWidth="200"
                              AutomationProperties.Name="If a name is already taken" ToolTip="What to do if a name is already taken" />
                    <TextBlock Text="{Binding DestinationLabel}" ToolTip="{Binding DestinationLabel}" Style="{StaticResource CaptionSingleLine}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                            ToolTip="Make a folder for each checked item, holding a shortcut that starts it. You can undo this from History." />
                    <StackPanel>
                        <CheckBox Content="Also change each game's own install folder" IsChecked="{Binding ThemeInstallFolders}"
                                  ToolTip="{Binding InstallFolderExplanation}" />
                        <TextBlock Text="{Binding InstallFolderExplanation}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding ThemeInstallFolders, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                       Visibility="{Binding Summary, Converter={StaticResource TextToVisible}}" />
            <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
