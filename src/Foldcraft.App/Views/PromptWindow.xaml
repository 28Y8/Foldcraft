<Window x:Class="Foldcraft.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="/Foldcraft;component/Themes/PrimaryButton.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Heading" Style="{StaticResource SectionHeading}" FontSize="20" TextWrapping="Wrap" />

            <TextBlock x:Name="Message" Grid.Row="1" Style="{StaticResource Body}" Margin="0,8,0,0" />

            <TextBox x:Name="Answer" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed" MaxLength="60"
                     AutomationProperties.Name="Your answer" />

            <Border x:Name="ItemsBox" Grid.Row="2" Style="{StaticResource NoteCard}" Margin="0,12,0,0"
                    Visibility="Collapsed">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl x:Name="Items" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" ToolTip="{Binding}" Style="{StaticResource CaptionSingleLine}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- The buttons sit on their own band, as they do in a Windows 11 dialog. -->
        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <WrapPanel x:Name="Buttons" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
