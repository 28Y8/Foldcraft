<UserControl x:Class="Foldcraft.App.Views.ThemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foldcraft.App.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/Foldcraft;component/Themes/PrimaryButton.xaml" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Save Current Look..." Command="{Binding SaveCurrentCommand}" Margin="0,0,8,0"
                        ToolTip="Keep what's in the designer as a theme" />
                <Button Content="Import..." Command="{Binding ImportCommand}" Margin="0,0,8,0"
                        ToolTip="Add themes from a file" />
                <Button Content="Export..." Command="{Binding ExportCommand}"
                        ToolTip="Save your own themes to a file you can share" />
            </StackPanel>
            <TextBlock Text="Themes" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource NoteCard}" Margin="0,12,0,0"
                Visibility="{Binding Notice, Converter={StaticResource TextToVisible}}">
            <TextBlock Text="{Binding Notice, NotifyOnTargetUpdated=True}" Style="{StaticResource Caption}"
                       views:LiveRegion.Announce="True"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTile}"
                     ItemContainerStyle="{StaticResource TileItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Themes">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <Image Width="72" Height="72" HorizontalAlignment="Center"
                                   Source="{Binding Image, Converter={StaticResource PngToImage}}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Mood}" Style="{StaticResource CaptionSingleLine}" TextAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Apply to Folders..." Command="{Binding ApplyToFoldersCommand}" Style="{StaticResource PrimaryButton}"
                    ToolTip="Choose any number of folders and give them this theme. You can undo this from History." />
            <Button DockPanel.Dock="Right" Content="Open in Designer" Command="{Binding UseInDesignCommand}" Margin="0,0,8,0"
                    ToolTip="Load this theme into the designer to adjust it" />
            <Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,0"
                    ToolTip="Delete this saved theme. Folders using it keep their look." />
            <TextBlock Text="Mood" Style="{StaticResource Caption}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Moods}" SelectedItem="{Binding SelectedMood}" MinWidth="160" HorizontalAlignment="Left"
                      AutomationProperties.Name="Filter themes by mood" />
        </DockPanel>
    </Grid>
</UserControl>
