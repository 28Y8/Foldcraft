<UserControl x:Class="Foldcraft.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Foldcraft.App.Views">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button x:Name="RestoreAllButton" DockPanel.Dock="Right" Content="Restore Everything..." Command="{Binding RestoreAllCommand}"
                    VerticalAlignment="Center"
                    ToolTip="Put every folder Foldcraft has changed back to how it was" />
            <Button DockPanel.Dock="Right" Content="Repair Icons" Command="{Binding RepairCommand}" Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTip="Find folders whose icon has gone missing or is out of date, and draw it again" />
            <TextBlock Text="History" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource NoteCard}" Margin="0,12,0,0"
                Visibility="{Binding Notice, Converter={StaticResource TextToVisible}}">
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource NoteCard}" Margin="0,12,0,0"
                Visibility="{Binding Results.Count, Converter={StaticResource CountToVisible}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="DismissButton" DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissResultsCommand}"
                            AutomationProperties.Name="Dismiss these results" />
                    <TextBlock Text="What just happened" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer MaxHeight="120" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource StatusSymbol}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" Margin="0,0,12,0"
                                               Style="{StaticResource CaptionSingleLine}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <!-- The list reaches into the page margin, so the scroll bar stays clear of the cards. -->
            <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}" Focusable="False" Margin="0,0,-16,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.Name="Past changes">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Image Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"
                                       Source="{Binding IconFile, Converter={StaticResource IconFileToImage}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" />
                                    <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}"
                                               Style="{StaticResource CaptionSingleLine}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="12,0,0,0" FontWeight="SemiBold"
                                                   Visibility="{Binding State, Converter={StaticResource TextToVisible}}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Undo" Command="{Binding UndoCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                        AutomationProperties.Name="{Binding UndoName}"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisible}}" />

                                <Expander Grid.Row="1" Grid.ColumnSpan="3" Margin="40,4,0,0" Header="Folders"
                                          Style="{StaticResource QuietExpander}"
                                          IsExpanded="{Binding IsExpanded}"
                                          AutomationProperties.Name="Folders in this change">
                                    <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" VerticalAlignment="Center"
                                                               Style="{StaticResource CaptionSingleLine}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" Margin="12,0"
                                                               Style="{StaticResource Caption}" />
                                                    <Button Grid.Column="2" Content="Restore Original" Command="{Binding RestoreCommand}"
                                                            AutomationProperties.Name="{Binding RestoreName}"
                                                            ToolTip="Put this folder back to how it was before Foldcraft first changed it"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:EmptyState Glyph="&#xE81C;" Title="Nothing here yet" Detail="Changes you make show up here, and you can undo any of them."
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </Grid>
</UserControl>
