<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Foldcraft.App.Views">

    <!--
        Every color here is a Fluent theme resource used through DynamicResource, so the app
        follows light, dark and high contrast without any color of its own.

        The layout is built from a few fixed measures, so screens line up with each other:
        spacing on a 4 px grid, 8 px corners on cards, 4 px corners on anything you press and
        four text sizes (12, 14, 16 and 28).
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <views:InverseBoolToVisibilityConverter x:Key="BoolToCollapsed" />
    <views:TextToVisibilityConverter x:Key="TextToVisible" />
    <views:CountToVisibilityConverter x:Key="CountToVisible" />
    <views:NullToVisibilityConverter x:Key="NullToVisible" />
    <views:NotNullToVisibilityConverter x:Key="NotNullToVisible" />
    <views:HexToBrushConverter x:Key="HexToBrush" />
    <views:PngToImageConverter x:Key="PngToImage" />
    <views:IconFileToImageConverter x:Key="IconFileToImage" />
    <views:ReadableTextConverter x:Key="ReadableTextOn" />

    <!-- Windows 10 doesn't have the variable font, and each of these falls back cleanly to the older one. -->
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

    <Thickness x:Key="PageMargin">24,20,24,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CompactCardPadding">12,8</Thickness>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <GridLength x:Key="ColumnGap">12</GridLength>

    <!-- Type -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Strong" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionSingleLine" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SymbolIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- A status always pairs its color with a symbol and words. -->
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusSymbol" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Text" Value="" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                <Setter Property="Text" Value="&#xE73E;" />
                <Setter Property="Margin" Value="0,2,4,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="Text" Value="&#xE7BA;" />
                <Setter Property="Margin" Value="0,2,4,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter Property="Text" Value="&#xE783;" />
                <Setter Property="Margin" Value="0,2,4,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Surfaces -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- A card whose content scrolls: the bar sits in the card's own margin, clear of the content. -->
    <Style x:Key="ScrollingCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,16,4,16" />
    </Style>

    <!-- A card with no heading, holding a short note. -->
    <Style x:Key="NoteCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
    </Style>

    <!-- One row on a settings-style screen. -->
    <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SettingGroup" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- The icon in a setting's row. Width is fixed so every row's text starts at the same place. -->
    <Style x:Key="SettingIcon" TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Width" Value="36" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <!-- The stage a folder preview stands on. -->
    <Style x:Key="Stage" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>

    <Style TargetType="views:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:EmptyState">
                    <StackPanel>
                        <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource SymbolIcon}" FontSize="24"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="DetailText" Text="{TemplateBinding Detail}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Detail" Value="">
                            <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The shell -->

    <Style x:Key="RailItem" TargetType="TabItem">
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="OverridesDefaultStyle" Value="True" />

        <!-- The tab control hands these two on to the screen it shows, so they decide whether it fills the window. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Height="40" Margin="4,2" Background="Transparent">
                        <Border views:Motion.ShowsOnHover="True" CornerRadius="{StaticResource ControlRadius}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border x:Name="Selected" CornerRadius="{StaticResource ControlRadius}" Visibility="Hidden"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />

                        <!-- The small bar that marks the screen you're on. -->
                        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MarkerScale" ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="14,0,8,0">
                            <TextBlock Text="{TemplateBinding views:NavigationRail.Glyph}" Style="{StaticResource SymbolIcon}" />
                            <ContentPresenter x:Name="Name" ContentSource="Header" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MarkerScale" Storyboard.TargetProperty="ScaleY" To="1"
                                                         Duration="{x:Static views:Motion.Quick}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MarkerScale" Storyboard.TargetProperty="ScaleY" To="0"
                                                         Duration="{x:Static views:Motion.Quick}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:NavigationRail}}" Value="True">
                            <Setter TargetName="Name" Property="Visibility" Value="Collapsed" />
                            <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavigationRailStyle" TargetType="views:NavigationRail">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RailItem}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:NavigationRail">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="RailColumn" Width="208" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The rail sits straight on the window's backdrop. Settings stay at the bottom of it. -->
                        <DockPanel IsItemsHost="True" LastChildFill="False" Margin="0,4"
                                   KeyboardNavigation.TabIndex="1"
                                   KeyboardNavigation.TabNavigation="Once"
                                   KeyboardNavigation.DirectionalNavigation="Cycle" />

                        <!-- The screens sit on a layer above it, the way Windows 11 lays out its own apps. -->
                        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  KeyboardNavigation.TabIndex="2" />
                                <ContentPresenter Grid.Row="1" Content="{TemplateBinding Status}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="RailColumn" Property="Width" Value="56" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet buttons, for actions that shouldn't compete with what's on the card. -->

    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border views:Motion.ShowsOnHover="True" CornerRadius="{StaticResource ControlRadius}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border x:Name="Pressed" CornerRadius="{StaticResource ControlRadius}" Visibility="Hidden"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pressed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--
        On or off, for a setting. It's still a check box underneath, so it keeps a check box's
        keyboard behavior and what a screen reader says about it.
    -->
    <Style x:Key="SwitchBox" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    Background="{DynamicResource ToggleSwitchFillOff}"
                                    BorderBrush="{DynamicResource ToggleSwitchStrokeOff}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource ToggleSwitchKnobFillOff}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20"
                                                         Duration="{x:Static views:Motion.Quick}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0"
                                                         Duration="{x:Static views:Motion.Quick}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain line that opens to show more, for inside a card. A boxed expander would be a card in a card. -->
    <Style x:Key="QuietExpanderHeader" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border views:Motion.ShowsOnHover="True" CornerRadius="{StaticResource ControlRadius}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="4,4,8,4">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource SymbolIcon}" FontSize="10" Width="16" TextAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5" Foreground="{TemplateBinding Foreground}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="Chevron" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Angle" To="90"
                                                         Duration="{x:Static views:Motion.Quick}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Angle" To="0"
                                                         Duration="{x:Static views:Motion.Quick}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietExpander" TargetType="Expander">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <!-- The name matters: this is how a screen reader finds the part that opens and closes. -->
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" HorizontalAlignment="Left"
                                      Style="{StaticResource QuietExpanderHeader}"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ExpandSite" Margin="24,4,0,0" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists -->

    <!--
        A list that is only a set of choices: no border, no scrolling of its own, one tab stop,
        arrow keys inside. Without a ScrollViewer the mouse wheel reaches the page behind it.
    -->
    <Style x:Key="ChoiceList" TargetType="ListBox">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A focus ring shows only when someone moves by keyboard. These rings fit their round or tile shapes. -->
    <Style x:Key="RoundFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Ellipse Margin="-1" StrokeThickness="2" Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border CornerRadius="{StaticResource CardRadius}" BorderThickness="2"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwatchItem" TargetType="ListBoxItem">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,2,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocus}" />
        <Setter Property="ToolTip" Value="{Binding Name}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Ellipse views:Motion.ShowsOnHover="True" StrokeThickness="2" Stroke="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Ellipse x:Name="SelectionRing" StrokeThickness="2" Stroke="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Hidden" />
                        <Border Margin="4" CornerRadius="11" BorderThickness="1"
                                Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A selected row is a soft fill with a small accent bar, the same as the screen you're on in the rail. -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border views:Motion.ShowsOnHover="True" CornerRadius="{StaticResource ControlRadius}"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        <Border x:Name="Selected" CornerRadius="{StaticResource ControlRadius}" Visibility="Hidden"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Hidden" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tile carries colored status text, which an accent fill would swallow, so selection is a ring. -->
    <Style x:Key="TileItem" TargetType="ListBoxItem">
        <Setter Property="Width" Value="128" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TileFocus}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border views:Motion.ShowsOnHover="True" CornerRadius="{StaticResource CardRadius}"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        <Border x:Name="SelectionRing" CornerRadius="{StaticResource CardRadius}" BorderThickness="2" Visibility="Hidden"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        <ContentPresenter Margin="4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlyphItem" TargetType="ListBoxItem">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="0,0,2,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TileFocus}" />
        <Setter Property="ToolTip" Value="{Binding Name}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border views:Motion.ShowsOnHover="True" CornerRadius="{StaticResource CardRadius}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border x:Name="SelectionRing" CornerRadius="{StaticResource CardRadius}" BorderThickness="2" Visibility="Hidden"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Image Source="{Binding Image, Converter={StaticResource PngToImage}}" Width="38" Height="38"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
